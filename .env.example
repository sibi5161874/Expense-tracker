# Copy the relevant keys into apps/web/.env.local (gitignored) — never fill in real
# values here, this file is committed to git as a template.

# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Only used server-side (Route Handlers / Edge Functions) — never expose to the client bundle
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres password (Project Settings > Database) — only needed for CLI/migration
# tooling, never referenced from app code, never committed
SUPABASE_DB_PASSWORD=
